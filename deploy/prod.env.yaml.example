# Template for deploy/prod.env.yaml (which is GITIGNORED — never commit the real one).
#
# Usage:
#   1. Copy this file to deploy/prod.env.yaml
#   2. Fill in the real values
#   3. Deploy with:
#      gcloud run deploy biblioteca-nce-back --source . --region us-central1 \
#        --env-vars-file deploy/prod.env.yaml
#
# Note: --env-vars-file REPLACES the service's env vars with exactly this set,
# which is what we want (the image itself carries no configuration).
# YAML format: values with special characters must be quoted.

SQLALCHEMY_DATABASE_URI: "postgresql://USER:URLENCODED_PASSWORD@HOST/DBNAME"
SUPABASE_JWT_SECRET: "supabase-legacy-jwt-secret-from-dashboard"
CORS_ORIGINS: "https://your-frontend-url.example.com"
MQTT_TOPICS: "your-topic-1,your-topic-2"
MQTT_TOPIC_JSON: "your-json-topic"
MQTT_TEST_TOPIC: ""
# "false" once the spec-008 VM worker runs the subscriber (lets Cloud Run scale to zero)
MQTT_SUBSCRIBER_IN_WEB: "true"
