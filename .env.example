# Local development configuration — copy to .env (gitignored) and adjust.
# Real production values NEVER go in .env — they live in deploy/prod.env.yaml
# (also gitignored). See docs/secrets.md.

# Local compose stack (docker-compose.yml)
SQLALCHEMY_DATABASE_URI=postgresql://postgres:localdev@localhost:5432/people_counter
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# MQTT topic names are intentionally NOT committed (public repo; on the public broker
# the names are the only gate — SEC-3). The placeholders below give a working
# self-contained local demo; real names live only in gitignored .env / deploy env.
MQTT_TOPICS=demo-sensor-json,demo-sensor-query
MQTT_TOPIC_JSON=demo-sensor-json
MQTT_TEST_TOPIC=

# JWT verification secret.
# - Any string works for API smoke tests (mint matching tokens with scripts/dev_token.py).
# - To log in through the local frontend with real Supabase users, replace with the
#   real project JWT secret (this file is gitignored — that's allowed, see docs/secrets.md).
SUPABASE_JWT_SECRET=local-dev-secret

# Allowed CORS origins for the local frontend (Vite default port)
CORS_ORIGINS=http://localhost:5173
